{
  "name": "mainframe-ftps",
  "displayName": "Mainframe FTPS (z/OS)",
  "description": "Browse z/OS data sets, edit members with automatic save to the PDS, submit jobs and view the spool, over a single FTPS session with keepalive and PIN + token login.",
  "version": "0.6.5",
  "publisher": "JorgeMiguel",
  "license": "MIT",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/jmgvieira/mainframe-ftps.git"
  },
  "bugs": {
    "url": "https://github.com/jmgvieira/mainframe-ftps/issues"
  },
  "homepage": "https://github.com/jmgvieira/mainframe-ftps#readme",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "mainframe",
    "z/OS",
    "JCL",
    "FTPS",
    "Easytrieve",
    "JES"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "mainframeFtps.connect",
        "title": "Connect to mainframe",
        "category": "Mainframe",
        "icon": "$(plug)"
      },
      {
        "command": "mainframeFtps.disconnect",
        "title": "Disconnect from mainframe",
        "category": "Mainframe",
        "icon": "$(debug-disconnect)"
      },
      {
        "command": "mainframeFtps.upload",
        "title": "Save file to mainframe",
        "category": "Mainframe",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "mainframeFtps.setTarget",
        "title": "Change file destination (PDS/member)",
        "category": "Mainframe"
      },
      {
        "command": "mainframeFtps.clearTarget",
        "title": "Remove file destination",
        "category": "Mainframe"
      },
      {
        "command": "mainframeFtps.submit",
        "title": "Submit JCL",
        "category": "Mainframe",
        "icon": "$(rocket)"
      },
      {
        "command": "mainframeFtps.jobStatus",
        "title": "Refresh job status",
        "category": "Mainframe",
        "icon": "$(refresh)"
      },
      {
        "command": "mainframeFtps.openSpool",
        "title": "View spool",
        "category": "Mainframe",
        "icon": "$(output)"
      },
      {
        "command": "mainframeFtps.listJobs",
        "title": "List jobs in JES",
        "category": "Mainframe",
        "icon": "$(list-unordered)"
      },
      {
        "command": "mainframeFtps.refreshJobs",
        "title": "Refresh job statuses",
        "category": "Mainframe",
        "icon": "$(refresh)"
      },
      {
        "command": "mainframeFtps.clearJobs",
        "title": "Clear job list",
        "category": "Mainframe",
        "icon": "$(clear-all)"
      },
      {
        "command": "mainframeFtps.removeJob",
        "title": "Remove from list",
        "category": "Mainframe"
      },
      {
        "command": "mainframeFtps.purgeJob",
        "title": "Delete job from JES (purge)",
        "category": "Mainframe"
      },
      {
        "command": "mainframeFtps.openMember",
        "title": "Open mainframe member…",
        "category": "Mainframe",
        "icon": "$(cloud-download)"
      },
      {
        "command": "mainframeFtps.forgetPin",
        "title": "Forget stored PIN",
        "category": "Mainframe"
      },
      {
        "command": "mainframeFtps.showLog",
        "title": "Show log",
        "category": "Mainframe"
      },
      {
        "command": "mainframeFtps.addFilter",
        "title": "Add data set filter",
        "category": "Mainframe",
        "icon": "$(filter)"
      },
      {
        "command": "mainframeFtps.editFilter",
        "title": "Edit filter",
        "category": "Mainframe",
        "icon": "$(edit)"
      },
      {
        "command": "mainframeFtps.removeFilter",
        "title": "Remove filter",
        "category": "Mainframe",
        "icon": "$(close)"
      },
      {
        "command": "mainframeFtps.refreshDatasets",
        "title": "Refresh",
        "category": "Mainframe",
        "icon": "$(refresh)"
      },
      {
        "command": "mainframeFtps.openDataset",
        "title": "Open",
        "category": "Mainframe",
        "icon": "$(go-to-file)"
      },
      {
        "command": "mainframeFtps.newMember",
        "title": "New member…",
        "category": "Mainframe",
        "icon": "$(new-file)"
      },
      {
        "command": "mainframeFtps.newDataset",
        "title": "New data set…",
        "category": "Mainframe",
        "icon": "$(new-folder)"
      },
      {
        "command": "mainframeFtps.renameItem",
        "title": "Rename…",
        "category": "Mainframe"
      },
      {
        "command": "mainframeFtps.deleteItem",
        "title": "Delete…",
        "category": "Mainframe"
      },
      {
        "command": "mainframeFtps.submitMember",
        "title": "Submit",
        "category": "Mainframe",
        "icon": "$(rocket)"
      },
      {
        "command": "mainframeFtps.copyName",
        "title": "Copy name",
        "category": "Mainframe"
      },
      {
        "command": "mainframeFtps.newDatasetLike",
        "title": "New data set like this one…",
        "category": "Mainframe"
      },
      {
        "command": "mainframeFtps.selectServer",
        "title": "Choose server",
        "category": "Mainframe",
        "icon": "$(server)"
      },
      {
        "command": "mainframeFtps.chooseLocalFolder",
        "title": "Choose local folder…",
        "category": "Mainframe",
        "icon": "$(folder-opened)"
      },
      {
        "command": "mainframeFtps.openLocalFolder",
        "title": "Open local folder in file explorer",
        "category": "Mainframe",
        "icon": "$(folder)"
      },
      {
        "command": "mainframeFtps.checkJobDatasets",
        "title": "Check data sets",
        "category": "Mainframe",
        "icon": "$(check-all)"
      },
      {
        "command": "mainframeFtps.refreshJobDatasets",
        "title": "Refresh",
        "category": "Mainframe",
        "icon": "$(refresh)"
      },
      {
        "command": "mainframeFtps.openJobDataset",
        "title": "Open",
        "category": "Mainframe",
        "icon": "$(go-to-file)"
      },
      {
        "command": "mainframeFtps.revealJclLine",
        "title": "Go to line in JCL",
        "category": "Mainframe",
        "icon": "$(list-selection)"
      },
      {
        "command": "mainframeFtps.copyJobDataset",
        "title": "Copy name",
        "category": "Mainframe"
      }
    ],
    "views": {
      "mainframe": [
        {
          "id": "mainframeFtps.jobDatasets",
          "name": "In this job"
        },
        {
          "id": "mainframeFtps.datasets",
          "name": "Data sets"
        },
        {
          "id": "mainframeFtps.jobs",
          "name": "Jobs"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "mainframeFtps.jobDatasets",
        "contents": "Open a JCL in the editor to see the data sets it uses, grouped by step. Click a data set to open it."
      },
      {
        "view": "mainframeFtps.datasets",
        "when": "!mainframeFtps.connected",
        "contents": "Not authenticated on the mainframe.\n[$(plug) Connect (PIN + token)](command:mainframeFtps.connect)"
      },
      {
        "view": "mainframeFtps.datasets",
        "when": "mainframeFtps.connected",
        "contents": "Add a filter to see your data sets, as in ISPF 3.4.\n[$(filter) Add filter](command:mainframeFtps.addFilter)\n[$(new-folder) New data set](command:mainframeFtps.newDataset)"
      },
      {
        "view": "mainframeFtps.jobs",
        "when": "!mainframeFtps.connected",
        "contents": "You have not submitted jobs from this folder yet.\n[$(plug) Connect (PIN + token)](command:mainframeFtps.connect)"
      },
      {
        "view": "mainframeFtps.jobs",
        "when": "mainframeFtps.connected",
        "contents": "You have not submitted jobs from this folder yet. Click a job to see its spool.\n[$(list-unordered) List my jobs in JES](command:mainframeFtps.listJobs)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "mainframeFtps.selectServer",
          "when": "view == mainframeFtps.datasets && mainframeFtps.multipleServers",
          "group": "navigation@0"
        },
        {
          "command": "mainframeFtps.connect",
          "when": "view == mainframeFtps.datasets && !mainframeFtps.connected",
          "group": "navigation@0"
        },
        {
          "command": "mainframeFtps.disconnect",
          "when": "view == mainframeFtps.datasets && mainframeFtps.connected",
          "group": "navigation@0"
        },
        {
          "command": "mainframeFtps.addFilter",
          "when": "view == mainframeFtps.datasets",
          "group": "navigation@1"
        },
        {
          "command": "mainframeFtps.newDataset",
          "when": "view == mainframeFtps.datasets",
          "group": "navigation@2"
        },
        {
          "command": "mainframeFtps.refreshDatasets",
          "when": "view == mainframeFtps.datasets",
          "group": "navigation@3"
        },
        {
          "command": "mainframeFtps.refreshJobs",
          "when": "view == mainframeFtps.jobs",
          "group": "navigation@1"
        },
        {
          "command": "mainframeFtps.listJobs",
          "when": "view == mainframeFtps.jobs",
          "group": "navigation@2"
        },
        {
          "command": "mainframeFtps.clearJobs",
          "when": "view == mainframeFtps.jobs",
          "group": "navigation@3"
        },
        {
          "command": "mainframeFtps.chooseLocalFolder",
          "when": "view == mainframeFtps.datasets",
          "group": "9_folder@1"
        },
        {
          "command": "mainframeFtps.openLocalFolder",
          "when": "view == mainframeFtps.datasets",
          "group": "9_folder@2"
        },
        {
          "command": "mainframeFtps.checkJobDatasets",
          "when": "view == mainframeFtps.jobDatasets",
          "group": "navigation@0"
        },
        {
          "command": "mainframeFtps.refreshJobDatasets",
          "when": "view == mainframeFtps.jobDatasets",
          "group": "navigation@1"
        }
      ],
      "view/item/context": [
        {
          "command": "mainframeFtps.jobStatus",
          "when": "viewItem == mfJob",
          "group": "inline@1"
        },
        {
          "command": "mainframeFtps.openSpool",
          "when": "viewItem == mfJob",
          "group": "a@1"
        },
        {
          "command": "mainframeFtps.removeJob",
          "when": "viewItem == mfJob",
          "group": "z@1"
        },
        {
          "command": "mainframeFtps.purgeJob",
          "when": "viewItem == mfJob",
          "group": "z@2"
        },
        {
          "command": "mainframeFtps.refreshDatasets",
          "when": "view == mainframeFtps.datasets && viewItem == mfFilter",
          "group": "inline@1"
        },
        {
          "command": "mainframeFtps.editFilter",
          "when": "viewItem == mfFilter",
          "group": "inline@2"
        },
        {
          "command": "mainframeFtps.removeFilter",
          "when": "viewItem == mfFilter",
          "group": "inline@3"
        },
        {
          "command": "mainframeFtps.newDataset",
          "when": "viewItem == mfFilter",
          "group": "1@1"
        },
        {
          "command": "mainframeFtps.newMember",
          "when": "viewItem == mfDsPO",
          "group": "inline@1"
        },
        {
          "command": "mainframeFtps.refreshDatasets",
          "when": "viewItem == mfDsPO",
          "group": "inline@2"
        },
        {
          "command": "mainframeFtps.newMember",
          "when": "viewItem == mfDsPO",
          "group": "1@1"
        },
        {
          "command": "mainframeFtps.newDatasetLike",
          "when": "viewItem =~ /^mfDs(PO|PS)$/",
          "group": "1@2"
        },
        {
          "command": "mainframeFtps.openDataset",
          "when": "viewItem =~ /^(mfDsPS|mfMember|mfDsMigrated)$/",
          "group": "1@0"
        },
        {
          "command": "mainframeFtps.submitMember",
          "when": "viewItem =~ /^(mfDsPS|mfMember)$/",
          "group": "inline@1"
        },
        {
          "command": "mainframeFtps.submitMember",
          "when": "viewItem =~ /^(mfDsPS|mfMember)$/",
          "group": "1@3"
        },
        {
          "command": "mainframeFtps.copyName",
          "when": "viewItem =~ /^(mfDs.*|mfMember)$/",
          "group": "2@1"
        },
        {
          "command": "mainframeFtps.renameItem",
          "when": "viewItem =~ /^(mfDsPO|mfDsPS|mfMember)$/",
          "group": "2@2"
        },
        {
          "command": "mainframeFtps.deleteItem",
          "when": "viewItem =~ /^(mfDsPO|mfDsPS|mfMember)$/",
          "group": "3@1"
        },
        {
          "command": "mainframeFtps.revealJclLine",
          "when": "viewItem == mfJobDd",
          "group": "inline@1"
        },
        {
          "command": "mainframeFtps.openJobDataset",
          "when": "viewItem == mfJobDd",
          "group": "1@1"
        },
        {
          "command": "mainframeFtps.revealJclLine",
          "when": "viewItem =~ /^mfJob(Dd|Step)$/",
          "group": "1@2"
        },
        {
          "command": "mainframeFtps.copyJobDataset",
          "when": "viewItem =~ /^mfJob(Dd|Member)$/",
          "group": "2@1"
        }
      ],
      "editor/title": [
        {
          "command": "mainframeFtps.submit",
          "when": "resourceExtname =~ /^\\.(jcl|JCL)$/ || editorLangId =~ /jcl/i || mainframeFtps.activeIsJcl",
          "group": "navigation@50"
        }
      ],
      "editor/context": [
        {
          "command": "mainframeFtps.submit",
          "group": "mainframe@1"
        },
        {
          "command": "mainframeFtps.upload",
          "group": "mainframe@2"
        },
        {
          "command": "mainframeFtps.setTarget",
          "group": "mainframe@3"
        }
      ],
      "explorer/context": [
        {
          "command": "mainframeFtps.upload",
          "when": "!explorerResourceIsFolder",
          "group": "mainframe@1"
        },
        {
          "command": "mainframeFtps.submit",
          "when": "!explorerResourceIsFolder",
          "group": "mainframe@2"
        },
        {
          "command": "mainframeFtps.setTarget",
          "when": "!explorerResourceIsFolder",
          "group": "mainframe@3"
        }
      ],
      "commandPalette": [
        {
          "command": "mainframeFtps.removeJob",
          "when": "false"
        },
        {
          "command": "mainframeFtps.purgeJob",
          "when": "false"
        },
        {
          "command": "mainframeFtps.editFilter",
          "when": "false"
        },
        {
          "command": "mainframeFtps.removeFilter",
          "when": "false"
        },
        {
          "command": "mainframeFtps.openDataset",
          "when": "false"
        },
        {
          "command": "mainframeFtps.renameItem",
          "when": "false"
        },
        {
          "command": "mainframeFtps.deleteItem",
          "when": "false"
        },
        {
          "command": "mainframeFtps.submitMember",
          "when": "false"
        },
        {
          "command": "mainframeFtps.copyName",
          "when": "false"
        },
        {
          "command": "mainframeFtps.newDatasetLike",
          "when": "false"
        },
        {
          "command": "mainframeFtps.openJobDataset",
          "when": "false"
        },
        {
          "command": "mainframeFtps.revealJclLine",
          "when": "false"
        },
        {
          "command": "mainframeFtps.copyJobDataset",
          "when": "false"
        }
      ]
    },
    "keybindings": [
      {
        "command": "mainframeFtps.submit",
        "key": "ctrl+alt+j",
        "mac": "cmd+alt+j",
        "when": "editorTextFocus"
      },
      {
        "command": "mainframeFtps.jobStatus",
        "key": "ctrl+alt+k",
        "mac": "cmd+alt+k"
      }
    ],
    "configuration": {
      "title": "Mainframe FTPS",
      "properties": {
        "mainframeFtps.hosts": {
          "type": "string",
          "default": "",
          "order": 0,
          "markdownDescription": "Mainframe servers, separated by `;`. Each entry is `NAME=host:port`; the name and the port are optional (without a name the host is shown, without a port `#mainframeFtps.port#` is used).\n\nExample: `PROD=mvs1.company.com;TEST=mvs2.company.com:991;mvs3.company.com`\n\nPick the server by clicking the **MF** indicator in the status bar or the server button in the **Mainframe** view. The user, PIN, TLS mode and code page are the same for every server."
        },
        "mainframeFtps.host": {
          "type": "string",
          "default": "",
          "order": 99,
          "markdownDeprecationMessage": "Replaced by `#mainframeFtps.hosts#`. The value is moved there automatically when the extension starts.",
          "description": "Old single-server setting (replaced by mainframeFtps.hosts)."
        },
        "mainframeFtps.port": {
          "type": "number",
          "default": 990,
          "order": 2,
          "markdownDescription": "Default FTPS port, for servers in `#mainframeFtps.hosts#` without an explicit port."
        },
        "mainframeFtps.tlsMode": {
          "type": "string",
          "enum": [
            "explicit",
            "implicit"
          ],
          "default": "explicit",
          "order": 3,
          "enumDescriptions": [
            "Explicit FTPS (AUTH TLS after connecting)",
            "Implicit FTPS (TLS from the start)"
          ],
          "description": "TLS mode. If the login times out right at the start, try the other mode."
        },
        "mainframeFtps.rejectUnauthorizedCertificates": {
          "type": "boolean",
          "default": true,
          "order": 4,
          "description": "Reject untrusted certificates. Disable only if the mainframe certificate is issued by an internal CA that is not installed in Windows."
        },
        "mainframeFtps.tlsServerName": {
          "type": "string",
          "default": "",
          "order": 5,
          "description": "Server name for SNI / certificate validation (optional)."
        },
        "mainframeFtps.user": {
          "type": "string",
          "default": "",
          "order": 6,
          "description": "TSO user ID. If empty, it is asked for when connecting."
        },
        "mainframeFtps.passcodeOrder": {
          "type": "string",
          "enum": [
            "pinThenToken",
            "tokenThenPin"
          ],
          "default": "pinThenToken",
          "order": 7,
          "enumDescriptions": [
            "Password = fixed PIN + token",
            "Password = token + fixed PIN"
          ],
          "description": "Order in which the fixed PIN and the token are typed (together, in a single field)."
        },
        "mainframeFtps.rememberPin": {
          "type": "boolean",
          "default": false,
          "order": 8,
          "description": "Store the fixed PIN in the operating system credential store (the token is always asked for)."
        },
        "mainframeFtps.keepAliveSeconds": {
          "type": "number",
          "default": 60,
          "minimum": 0,
          "order": 9,
          "description": "Keepalive NOOP interval in seconds (0 = off). Must be well below the server idle timeout (~4 min)."
        },
        "mainframeFtps.idleDisconnectMinutes": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "order": 10,
          "description": "Disconnect after N minutes without user operations (0 = never)."
        },
        "mainframeFtps.timeoutSeconds": {
          "type": "number",
          "default": 30,
          "order": 11,
          "description": "Timeout of each FTP operation, in seconds."
        },
        "mainframeFtps.siteCommands": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "order": 12,
          "markdownDescription": "`SITE` commands sent right after login, without the word SITE. E.g. `SBDATACONN=(IBM-1047,ISO8859-1)`, `TRAILINGBLANKS`."
        },
        "mainframeFtps.autoUploadOnSave": {
          "type": "boolean",
          "default": true,
          "order": 13,
          "description": "Save to the mainframe every time the file is saved."
        },
        "mainframeFtps.fileExtensions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            ".jcl",
            ".ezt",
            ".cbl",
            ".cpy",
            ".proc"
          ],
          "order": 14,
          "description": "File extensions for which the mainframe destination is asked on the first save (files opened from the Mainframe view already know their destination)."
        },
        "mainframeFtps.hostCodePage": {
          "type": "string",
          "default": "IBM-1147",
          "order": 15,
          "markdownDescription": "Mainframe EBCDIC code page. Sent after login as `SITE SBDATACONN=(<this>,<transferEncoding>)`. Empty = use the server configuration. IBM-1147 = France with €."
        },
        "mainframeFtps.transferEncoding": {
          "type": "string",
          "enum": [
            "iso8859-15",
            "latin1",
            "utf8"
          ],
          "default": "iso8859-15",
          "order": 16,
          "enumDescriptions": [
            "ISO-8859-15 (Latin-9, with €) – recommended with IBM-1147",
            "ISO-8859-1 (Latin-1, without €)",
            "UTF-8 (requires MBCS configuration on the server)"
          ],
          "description": "PC-side encoding of the ASCII transfer."
        },
        "mainframeFtps.recordLength": {
          "type": "number",
          "default": 80,
          "order": 17,
          "description": "Expected LRECL; you are warned about longer lines."
        },
        "mainframeFtps.jobPollSeconds": {
          "type": "number",
          "default": 5,
          "order": 18,
          "description": "Interval, in seconds, for checking the status of a submitted job."
        },
        "mainframeFtps.jobPollMaxMinutes": {
          "type": "number",
          "default": 10,
          "order": 19,
          "description": "Maximum time, in minutes, to follow a submitted job."
        },
        "mainframeFtps.datasetFilters": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "order": 20,
          "description": "Data set filters shown in the Mainframe view (e.g. U12345.*)."
        },
        "mainframeFtps.localFolder": {
          "type": "string",
          "default": "",
          "order": 21,
          "markdownDescription": "Local folder for files opened from the Mainframe view, with the same names as on the mainframe (`<PDS>/<MEMBER>`). The file associations (`.mainframe-ftps.json`) are kept in the same folder.\n\nEmpty = `mainframe/` inside the folder open in VS Code; with no folder open, you are asked once where to keep the files. Use **Mainframe: Choose local folder…** to pick it without typing. `${workspaceFolder}` and relative paths are accepted."
        },
        "mainframeFtps.qualifierExtensions": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "order": 22,
          "markdownDescription": "Language by data set qualifier, given as a file extension, in addition to the built-in ones (JCL/CNTL/PROC → .jcl, EZT/EASY → .ezt, COBOL → .cbl, COPY → .cpy). E.g. `{ \"JOBLIB\": \".jcl\" }`."
        },
        "mainframeFtps.defaultExtension": {
          "type": "string",
          "default": ".jcl",
          "order": 23,
          "markdownDescription": "Language for data sets whose name does not indicate it, given as a file extension: `.jcl`, `.ezt`, `.cbl`, `.txt`… Local files keep the mainframe name, without an extension."
        },
        "mainframeFtps.spoolStripAsa": {
          "type": "boolean",
          "default": true,
          "order": 20,
          "description": "In the spool, remove the print control character (ASA) from column 1 when the file has one."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "mainframe",
          "title": "Mainframe",
          "icon": "resources/mainframe.svg"
        }
      ]
    },
    "colors": [
      {
        "id": "mainframeFtps.connectedForeground",
