{
  "name": "mainframe-ftps",
  "displayName": "Mainframe FTPS (z/OS)",
  "description": "Navega nos data sets do z/OS, edita membros com gravação automática no PDS, submete jobs e mostra o spool, numa única sessão FTPS com keepalive e login por PIN + token.",
  "version": "0.3.3",
  "publisher": "JorgeMiguel",
  "license": "MIT",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/jmgvieira/mainframe-ftps.git"
  },
  "bugs": {
    "url": "https://github.com/jmgvieira/mainframe-ftps/issues"
  },
  "homepage": "https://github.com/jmgvieira/mainframe-ftps#readme",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "mainframe",
    "z/OS",
    "JCL",
    "FTPS",
    "Easytrieve",
    "JES"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "mainframeFtps.connect",
        "title": "Ligar ao mainframe",
        "category": "Mainframe",
        "icon": "$(plug)"
      },
      {
        "command": "mainframeFtps.disconnect",
        "title": "Desligar do mainframe",
        "category": "Mainframe",
        "icon": "$(debug-disconnect)"
      },
      {
        "command": "mainframeFtps.upload",
        "title": "Gravar ficheiro no mainframe",
        "category": "Mainframe",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "mainframeFtps.setTarget",
        "title": "Alterar destino (PDS/membro) do ficheiro",
        "category": "Mainframe"
      },
      {
        "command": "mainframeFtps.clearTarget",
        "title": "Remover destino do ficheiro",
        "category": "Mainframe"
      },
      {
        "command": "mainframeFtps.submit",
        "title": "Submeter JCL",
        "category": "Mainframe",
        "icon": "$(rocket)"
      },
      {
        "command": "mainframeFtps.jobStatus",
        "title": "Atualizar estado do job",
        "category": "Mainframe",
        "icon": "$(refresh)"
      },
      {
        "command": "mainframeFtps.openSpool",
        "title": "Ver spool",
        "category": "Mainframe",
        "icon": "$(output)"
      },
      {
        "command": "mainframeFtps.listJobs",
        "title": "Listar jobs no JES",
        "category": "Mainframe",
        "icon": "$(list-unordered)"
      },
      {
        "command": "mainframeFtps.refreshJobs",
        "title": "Atualizar estado dos jobs",
        "category": "Mainframe",
        "icon": "$(refresh)"
      },
      {
        "command": "mainframeFtps.clearJobs",
        "title": "Limpar lista de jobs",
        "category": "Mainframe",
        "icon": "$(clear-all)"
      },
      {
        "command": "mainframeFtps.removeJob",
        "title": "Remover da lista",
        "category": "Mainframe"
      },
      {
        "command": "mainframeFtps.purgeJob",
        "title": "Apagar job do JES (purge)",
        "category": "Mainframe"
      },
      {
        "command": "mainframeFtps.openMember",
        "title": "Abrir membro do mainframe…",
        "category": "Mainframe",
        "icon": "$(cloud-download)"
      },
      {
        "command": "mainframeFtps.forgetPin",
        "title": "Esquecer PIN guardado",
        "category": "Mainframe"
      },
      {
        "command": "mainframeFtps.showLog",
        "title": "Mostrar log",
        "category": "Mainframe"
      },
      {
        "command": "mainframeFtps.addFilter",
        "title": "Adicionar filtro de data sets",
        "category": "Mainframe",
        "icon": "$(filter)"
      },
      {
        "command": "mainframeFtps.editFilter",
        "title": "Alterar filtro",
        "category": "Mainframe",
        "icon": "$(edit)"
      },
      {
        "command": "mainframeFtps.removeFilter",
        "title": "Remover filtro",
        "category": "Mainframe",
        "icon": "$(close)"
      },
      {
        "command": "mainframeFtps.refreshDatasets",
        "title": "Atualizar",
        "category": "Mainframe",
        "icon": "$(refresh)"
      },
      {
        "command": "mainframeFtps.openDataset",
        "title": "Abrir",
        "category": "Mainframe",
        "icon": "$(go-to-file)"
      },
      {
        "command": "mainframeFtps.newMember",
        "title": "Novo membro…",
        "category": "Mainframe",
        "icon": "$(new-file)"
      },
      {
        "command": "mainframeFtps.newDataset",
        "title": "Novo data set…",
        "category": "Mainframe",
        "icon": "$(new-folder)"
      },
      {
        "command": "mainframeFtps.renameItem",
        "title": "Renomear…",
        "category": "Mainframe"
      },
      {
        "command": "mainframeFtps.deleteItem",
        "title": "Apagar…",
        "category": "Mainframe"
      },
      {
        "command": "mainframeFtps.submitMember",
        "title": "Submeter",
        "category": "Mainframe",
        "icon": "$(rocket)"
      },
      {
        "command": "mainframeFtps.copyName",
        "title": "Copiar nome",
        "category": "Mainframe"
      },
      {
        "command": "mainframeFtps.newDatasetLike",
        "title": "Novo data set igual a este…",
        "category": "Mainframe"
      }
    ],
    "views": {
      "mainframe": [
        {
          "id": "mainframeFtps.datasets",
          "name": "Data sets"
        },
        {
          "id": "mainframeFtps.jobs",
          "name": "Jobs"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "mainframeFtps.datasets",
        "when": "!mainframeFtps.connected",
        "contents": "Não autenticado no mainframe.\n[$(plug) Ligar (PIN + token)](command:mainframeFtps.connect)"
      },
      {
        "view": "mainframeFtps.datasets",
        "when": "mainframeFtps.connected",
        "contents": "Adicione um filtro para ver os seus data sets, como no ISPF 3.4.\n[$(filter) Adicionar filtro](command:mainframeFtps.addFilter)\n[$(new-folder) Novo data set](command:mainframeFtps.newDataset)"
      },
      {
        "view": "mainframeFtps.jobs",
        "when": "!mainframeFtps.connected",
        "contents": "Ainda não submeteu jobs nesta pasta.\n[$(plug) Ligar (PIN + token)](command:mainframeFtps.connect)"
      },
      {
        "view": "mainframeFtps.jobs",
        "when": "mainframeFtps.connected",
        "contents": "Ainda não submeteu jobs nesta pasta. Clique num job para ver o spool.\n[$(list-unordered) Listar os meus jobs no JES](command:mainframeFtps.listJobs)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "mainframeFtps.connect",
          "when": "view == mainframeFtps.datasets && !mainframeFtps.connected",
          "group": "navigation@0"
        },
        {
          "command": "mainframeFtps.disconnect",
          "when": "view == mainframeFtps.datasets && mainframeFtps.connected",
          "group": "navigation@0"
        },
        {
          "command": "mainframeFtps.addFilter",
          "when": "view == mainframeFtps.datasets",
          "group": "navigation@1"
        },
        {
          "command": "mainframeFtps.newDataset",
          "when": "view == mainframeFtps.datasets",
          "group": "navigation@2"
        },
        {
          "command": "mainframeFtps.refreshDatasets",
          "when": "view == mainframeFtps.datasets",
          "group": "navigation@3"
        },
        {
          "command": "mainframeFtps.refreshJobs",
          "when": "view == mainframeFtps.jobs",
          "group": "navigation@1"
        },
        {
          "command": "mainframeFtps.listJobs",
          "when": "view == mainframeFtps.jobs",
          "group": "navigation@2"
        },
        {
          "command": "mainframeFtps.clearJobs",
          "when": "view == mainframeFtps.jobs",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "mainframeFtps.jobStatus",
          "when": "viewItem == mfJob",
          "group": "inline@1"
        },
        {
          "command": "mainframeFtps.openSpool",
          "when": "viewItem == mfJob",
          "group": "a@1"
        },
        {
          "command": "mainframeFtps.removeJob",
          "when": "viewItem == mfJob",
          "group": "z@1"
        },
        {
          "command": "mainframeFtps.purgeJob",
          "when": "viewItem == mfJob",
          "group": "z@2"
        },
        {
          "command": "mainframeFtps.refreshDatasets",
          "when": "view == mainframeFtps.datasets && viewItem == mfFilter",
          "group": "inline@1"
        },
        {
          "command": "mainframeFtps.editFilter",
          "when": "viewItem == mfFilter",
          "group": "inline@2"
        },
        {
          "command": "mainframeFtps.removeFilter",
          "when": "viewItem == mfFilter",
          "group": "inline@3"
        },
        {
          "command": "mainframeFtps.newDataset",
          "when": "viewItem == mfFilter",
          "group": "1@1"
        },
        {
          "command": "mainframeFtps.newMember",
          "when": "viewItem == mfDsPO",
          "group": "inline@1"
        },
        {
          "command": "mainframeFtps.refreshDatasets",
          "when": "viewItem == mfDsPO",
          "group": "inline@2"
        },
        {
          "command": "mainframeFtps.newMember",
          "when": "viewItem == mfDsPO",
          "group": "1@1"
        },
        {
          "command": "mainframeFtps.newDatasetLike",
          "when": "viewItem =~ /^mfDs(PO|PS)$/",
          "group": "1@2"
        },
        {
          "command": "mainframeFtps.openDataset",
          "when": "viewItem =~ /^(mfDsPS|mfMember|mfDsMigrated)$/",
          "group": "1@0"
        },
        {
          "command": "mainframeFtps.submitMember",
          "when": "viewItem =~ /^(mfDsPS|mfMember)$/",
          "group": "inline@1"
        },
        {
          "command": "mainframeFtps.submitMember",
          "when": "viewItem =~ /^(mfDsPS|mfMember)$/",
          "group": "1@3"
        },
        {
          "command": "mainframeFtps.copyName",
          "when": "viewItem =~ /^(mfDs.*|mfMember)$/",
          "group": "2@1"
        },
        {
          "command": "mainframeFtps.renameItem",
          "when": "viewItem =~ /^(mfDsPO|mfDsPS|mfMember)$/",
          "group": "2@2"
        },
        {
          "command": "mainframeFtps.deleteItem",
          "when": "viewItem =~ /^(mfDsPO|mfDsPS|mfMember)$/",
          "group": "3@1"
        }
      ],
      "editor/title": [
        {
          "command": "mainframeFtps.submit",
          "when": "resourceExtname =~ /^\\.(jcl|JCL)$/",
          "group": "navigation@50"
        }
      ],
      "editor/context": [
        {
          "command": "mainframeFtps.submit",
          "group": "mainframe@1"
        },
        {
          "command": "mainframeFtps.upload",
          "group": "mainframe@2"
        },
        {
          "command": "mainframeFtps.setTarget",
          "group": "mainframe@3"
        }
      ],
      "explorer/context": [
        {
          "command": "mainframeFtps.upload",
          "when": "!explorerResourceIsFolder",
          "group": "mainframe@1"
        },
        {
          "command": "mainframeFtps.submit",
          "when": "!explorerResourceIsFolder",
          "group": "mainframe@2"
        },
        {
          "command": "mainframeFtps.setTarget",
          "when": "!explorerResourceIsFolder",
          "group": "mainframe@3"
        }
      ],
      "commandPalette": [
        {
          "command": "mainframeFtps.removeJob",
          "when": "false"
        },
        {
          "command": "mainframeFtps.purgeJob",
          "when": "false"
        },
        {
          "command": "mainframeFtps.editFilter",
          "when": "false"
        },
        {
          "command": "mainframeFtps.removeFilter",
          "when": "false"
        },
        {
          "command": "mainframeFtps.openDataset",
          "when": "false"
        },
        {
          "command": "mainframeFtps.renameItem",
          "when": "false"
        },
        {
          "command": "mainframeFtps.deleteItem",
          "when": "false"
        },
        {
          "command": "mainframeFtps.submitMember",
          "when": "false"
        },
        {
          "command": "mainframeFtps.copyName",
          "when": "false"
        },
        {
          "command": "mainframeFtps.newDatasetLike",
          "when": "false"
        }
      ]
    },
    "keybindings": [
      {
        "command": "mainframeFtps.submit",
        "key": "ctrl+alt+j",
        "mac": "cmd+alt+j",
        "when": "editorTextFocus"
      },
      {
        "command": "mainframeFtps.jobStatus",
        "key": "ctrl+alt+k",
        "mac": "cmd+alt+k"
      }
    ],
    "configuration": {
      "title": "Mainframe FTPS",
      "properties": {
        "mainframeFtps.host": {
          "type": "string",
          "default": "",
          "order": 1,
          "description": "Endereço do servidor FTP do z/OS."
        },
        "mainframeFtps.port": {
          "type": "number",
          "default": 990,
          "order": 2,
          "description": "Porta FTPS."
        },
        "mainframeFtps.tlsMode": {
          "type": "string",
          "enum": [
            "explicit",
            "implicit"
          ],
          "default": "explicit",
          "order": 3,
          "enumDescriptions": [
            "FTPS explícito (AUTH TLS após ligar)",
            "FTPS implícito (TLS logo à ligação)"
          ],
          "description": "Modo TLS. Se o login falhar logo no início com timeout, experimente o outro modo."
        },
        "mainframeFtps.rejectUnauthorizedCertificates": {
          "type": "boolean",
          "default": true,
          "order": 4,
          "description": "Recusar certificados não confiáveis. Desative só se o certificado do mainframe for de uma CA interna não instalada no Windows."
        },
        "mainframeFtps.tlsServerName": {
          "type": "string",
          "default": "",
          "order": 5,
          "description": "Nome do servidor para SNI/validação do certificado (opcional)."
        },
        "mainframeFtps.user": {
          "type": "string",
          "default": "",
          "order": 6,
          "description": "Utilizador TSO. Se vazio, é pedido ao ligar."
        },
        "mainframeFtps.passcodeOrder": {
          "type": "string",
          "enum": [
            "pinThenToken",
            "tokenThenPin"
          ],
          "default": "pinThenToken",
          "order": 7,
          "enumDescriptions": [
            "Password = PIN fixo + token",
            "Password = token + PIN fixo"
          ],
          "description": "Ordem em que o PIN fixo e o token são escritos (seguidos, num só campo)."
        },
        "mainframeFtps.rememberPin": {
          "type": "boolean",
          "default": false,
          "order": 8,
          "description": "Guardar o PIN fixo no cofre de credenciais do sistema (o token é sempre pedido)."
        },
        "mainframeFtps.keepAliveSeconds": {
          "type": "number",
          "default": 60,
          "minimum": 0,
          "order": 9,
          "description": "Intervalo do NOOP de keepalive em segundos (0 = desligado). Deve ser bem inferior ao timeout do servidor (~4 min)."
        },
        "mainframeFtps.idleDisconnectMinutes": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "order": 10,
          "description": "Desligar após N minutos sem operações do utilizador (0 = nunca)."
        },
        "mainframeFtps.timeoutSeconds": {
          "type": "number",
          "default": 30,
          "order": 11,
          "description": "Timeout de cada operação FTP."
        },
        "mainframeFtps.siteCommands": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "order": 12,
          "markdownDescription": "Comandos `SITE` enviados logo após o login, sem a palavra SITE. Ex.: `SBDATACONN=(IBM-1047,ISO8859-1)`, `TRAILINGBLANKS`."
        },
        "mainframeFtps.autoUploadOnSave": {
          "type": "boolean",
          "default": true,
          "order": 13,
          "description": "Gravar no mainframe sempre que o ficheiro é guardado."
        },
        "mainframeFtps.fileExtensions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            ".jcl",
            ".ezt",
            ".cbl",
            ".cpy",
            ".proc"
          ],
          "order": 14,
          "description": "Extensões para as quais é perguntado o destino na primeira gravação."
        },
        "mainframeFtps.hostCodePage": {
          "type": "string",
          "default": "IBM-1147",
          "order": 15,
          "markdownDescription": "Código de página EBCDIC do mainframe. É enviado após o login como `SITE SBDATACONN=(<este>,<transferEncoding>)`. Vazio = usar a configuração do servidor. IBM-1147 = França com €."
        },
        "mainframeFtps.transferEncoding": {
          "type": "string",
          "enum": [
            "iso8859-15",
            "latin1",
            "utf8"
          ],
          "default": "iso8859-15",
          "order": 16,
          "enumDescriptions": [
            "ISO-8859-15 (Latin-9, com €) – recomendado com IBM-1147",
            "ISO-8859-1 (Latin-1, sem €)",
            "UTF-8 (requer configuração MBCS no servidor)"
          ],
          "description": "Codificação do lado do PC na transferência ASCII."
        },
        "mainframeFtps.recordLength": {
          "type": "number",
          "default": 80,
          "order": 17,
          "description": "LRECL esperado; avisa se houver linhas mais compridas."
        },
        "mainframeFtps.jobPollSeconds": {
          "type": "number",
          "default": 5,
          "order": 18,
          "description": "Intervalo de consulta do estado de um job submetido."
        },
        "mainframeFtps.jobPollMaxMinutes": {
          "type": "number",
          "default": 10,
          "order": 19,
          "description": "Tempo máximo a acompanhar um job submetido."
        },
        "mainframeFtps.datasetFilters": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "order": 20,
          "description": "Filtros de data sets mostrados na vista Mainframe (ex.: U12345.*)."
        },
        "mainframeFtps.localFolder": {
          "type": "string",
          "default": "",
          "order": 21,
          "markdownDescription": "Pasta local onde ficam os membros abertos a partir da vista. Vazio = `mainframe/` dentro da pasta aberta no VS Code. Pode usar `${workspaceFolder}`."
        },
        "mainframeFtps.qualifierExtensions": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "order": 22,
          "markdownDescription": "Extensão local por qualificador do data set, além das predefinidas (JCL/CNTL/PROC → .jcl, EZT/EASY → .ezt, COBOL → .cbl, COPY → .cpy). Ex.: `{ \"JOBLIB\": \".jcl\" }`."
        },
        "mainframeFtps.defaultExtension": {
          "type": "string",
          "default": ".jcl",
          "order": 23,
          "markdownDescription": "Extensão local dos data sets cujo nome não indica o tipo (nenhum qualificador em `qualifierExtensions` nem nas predefinições). Ex.: `.jcl`, `.ezt`, `.txt`."
        },
        "mainframeFtps.spoolStripAsa": {
          "type": "boolean",
          "default": true,
          "order": 20,
          "description": "No spool, retirar o carácter de controlo de impressão (ASA) da coluna 1 quando o ficheiro o tiver."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "mainframe",
          "title": "Mainframe",
          "icon": "resources/mainframe.svg"
        }
      ]
    },
    "colors": [
      {
        "id": "mainframeFtps.connectedForeground",
        "description": "Cor do indicador de autenticação quando ligado.",
        "defaults": {
          "dark": "#3FB950",
          "light": "#1A7F37",
          "highContrast": "#3FB950",
          "highContrastLight": "#1A7F37"
        }
      },
      {
        "id": "mainframeFtps.disconnectedForeground",
        "description": "Cor do indicador de autenticação quando desligado.",
        "defaults": {
          "dark": "#8B949E",
          "light": "#6E7781",
          "highContrast": "#FFFFFF",
          "highContrastLight": "#000000"
        }
      }
    ],
    "languages": [
      {
        "id": "mfspool",
        "aliases": [
          "Spool z/OS"
        ],
        "extensions": [
          ".spool"
        ]
      }
    ],
    "grammars": [
      {
        "language": "mfspool",
        "scopeName": "source.mfspool",
        "path": "./syntaxes/mfspool.tmLanguage.json"
      }
    ]
  },
  "scripts": {
    "compile": "tsc --noEmit -p . && esbuild src/extension.ts --bundle --platform=node --target=node18 --external:vscode --outfile=dist/extension.js",
    "package": "npm run compile && vsce package --no-dependencies"
  },
  "dependencies": {
    "basic-ftp": "^6.2.6"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "1.85.0",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.28.0",
    "typescript": "^5.0.0"
  }
}
